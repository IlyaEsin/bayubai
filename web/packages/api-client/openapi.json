{
  "openapi": "3.1.1",
  "info": {
    "title": "CareNest.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/identity/email/start": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "StartEmailSignIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailStartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/email/complete": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "CompleteEmailSignIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailCompleteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/signout": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "SignOut",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/identity/providers": {
      "get": {
        "tags": [
          "Identity"
        ],
        "operationId": "GetProviders",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/external/{provider}/start": {
      "get": {
        "tags": [
          "Identity"
        ],
        "operationId": "StartExternalSignIn",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "returnUrl",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timeZone",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/identity/external/callback": {
      "get": {
        "tags": [
          "Identity"
        ],
        "operationId": "CompleteExternalSignIn",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/identity/telegram/complete": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "CompleteTelegramSignIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelegramCompleteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/admin/consultants": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "CreateConsultant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConsultantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateConsultantResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/me/consultants": {
      "get": {
        "tags": [
          "Identity"
        ],
        "operationId": "ListMyConsultants",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConsultantResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/invitations/accept": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "AcceptInvitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvitationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/me": {
      "get": {
        "tags": [
          "Identity"
        ],
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Identity"
        ],
        "operationId": "UpdateMe",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Identity"
        ],
        "operationId": "DeleteMe",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/identity/invitations": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "CreateInvitation",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateInvitationResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Identity"
        ],
        "operationId": "ListInvitations",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InvitationResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/clients": {
      "get": {
        "tags": [
          "Identity"
        ],
        "operationId": "ListClients",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClientResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ClientResponse": {
        "required": [
          "userId",
          "displayName",
          "language",
          "timeZone",
          "linkedAt"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "linkedAt": {
            "$ref": "#/components/schemas/Instant"
          }
        }
      },
      "ConsultantResponse": {
        "required": [
          "userId",
          "displayName",
          "timeZone",
          "linkedAt"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "linkedAt": {
            "$ref": "#/components/schemas/Instant"
          }
        }
      },
      "CreateConsultantRequest": {
        "required": [
          "email",
          "displayName",
          "language",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          },
          "displayName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "CreateConsultantResponse": {
        "required": [
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateInvitationResponse": {
        "required": [
          "id",
          "url",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/Instant"
          }
        }
      },
      "EmailCompleteRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "EmailStartRequest": {
        "required": [
          "email",
          "callbackUrl",
          "language",
          "timeZone",
          "mode"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          },
          "callbackUrl": {
            "maxLength": 2048,
            "minLength": 0,
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        }
      },
      "ErrorCode": {
        "enum": [
          "identity.external_login_failed",
          "identity.invalid_return_url",
          "identity.invalid_sign_in_mode",
          "identity.invite_expired",
          "identity.invite_not_found",
          "identity.invite_own",
          "identity.invite_used",
          "identity.link_session_mismatch",
          "identity.login_already_linked",
          "identity.magic_link_expired",
          "identity.magic_link_invalid",
          "identity.magic_link_other_browser",
          "identity.magic_link_used",
          "identity.not_signed_in",
          "identity.provider_unavailable",
          "rate_limited",
          "validation_failed"
        ],
        "type": "string"
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Instant": {
        "type": "string",
        "format": "date-time"
      },
      "InvitationResponse": {
        "required": [
          "id",
          "createdAt",
          "expiresAt",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/Instant"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "displayName",
          "language",
          "timeZone",
          "roles",
          "signInMethods"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signInMethods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProvidersResponse": {
        "required": [
          "providers",
          "telegramBotName"
        ],
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "telegramBotName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TelegramCompleteRequest": {
        "required": [
          "auth",
          "mode",
          "language",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "auth": {
            "type": "object"
          },
          "mode": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "UpdateProfileRequest": {
        "required": [
          "displayName",
          "language",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Identity"
    }
  ]
}
